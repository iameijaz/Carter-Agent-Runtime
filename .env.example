# Carter — configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# ONLY the first section is required. Everything below it is optional: an unset
# key means the tools that need it refuse before touching the network, which
# does not stop the runtime booting. Defaults shown after `=` are the real
# defaults from the code — you can delete those lines entirely.


# ═══ REQUIRED ═══════════════════════════════════════════════════════════════
# One key. Any OpenAI-compatible provider works; OpenRouter is the default
# because it needs no model download on a fresh clone.
# Get one at https://openrouter.ai/keys
OPENROUTER_API=

# Point the same client somewhere else to run fully local — this is an env
# edit, never a code change.
#   Ollama          http://localhost:11434/v1
#   vLLM/llama.cpp  http://localhost:8000/v1
# Empty = OpenRouter.
LLM_BASE_URL=
LLM_MODEL=openai/gpt-4.1


# ═══ WEB HUD ════════════════════════════════════════════════════════════════
# Loopback-only by design, no auth. Do not bind this to 0.0.0.0.
CARTER_PORT=3132
CARTER_HOST=127.0.0.1


# ═══ OPTIONAL: extra model providers ════════════════════════════════════════
# Only for speech-to-text and embeddings, which are OpenAI-only. The agent loop
# does not need it. Also accepted as a fallback for OPENROUTER_API above.
OPENAI_API_KEY=

# Grok (xAI) — social/sentiment routing. https://console.x.ai
GROK_API_KEY=
GROK_MODEL=grok-4.3
GROK_BASE_URL=https://api.x.ai/v1

# llama.cpp server, if you run one. See docs/LOCAL_LLM.md.
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_MODEL_NAME=local


# ═══ OPTIONAL: mailbox ══════════════════════════════════════════════════════
# IMAP read + SMTP send. Use an app-specific password, never your account one.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Only set false against a host you control — it disables TLS cert verification.
MAIL_TLS_VERIFY=true


# ═══ OPTIONAL: library catalogue ════════════════════════════════════════════
# Any VuFind/finc catalogue, which most academic libraries run.
# LIBRARY_INSTITUTION is the ISIL code used as a search filter; empty =
# unfiltered.
LIBRARY_BASE_URL=
LIBRARY_INSTITUTION=


# ═══ OPTIONAL: Telegram bot ═════════════════════════════════════════════════
# Token from @BotFather. Chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ═══ OPTIONAL: speech-to-text ═══════════════════════════════════════════════
CARTER_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Deepgram is the fallback provider. https://console.deepgram.com
DEEPGRAM_API_KEY=


# ═══ OPTIONAL: image search ═════════════════════════════════════════════════
# Waterfall: Pixabay → Unsplash → Openverse → Wikimedia. The last two are
# keyless and always available, so both keys below are genuinely optional.
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=


# ═══ OPTIONAL: research / OCR ═══════════════════════════════════════════════
# Removes Semantic Scholar rate limits. https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# Unpaywall open-access PDF lookup — any real email address; they ask for one.
UNPAYWALL_EMAIL=
# Cloud OCR, tier 3 after PaddleOCR + Tesseract. Read by scripts/ocr_extract.py.
GOOGLE_CLOUD_VISION_KEY=


# ═══ OPTIONAL: Google Calendar MCP ══════════════════════════════════════════
# Absolute path to the OAuth client-secret JSON you download from Google Cloud
# Console. Read by scripts/auth-google-calendar.cmd. Untested in this tree.
GOOGLE_OAUTH_CREDENTIALS=


# ═══ OPTIONAL: external binaries ════════════════════════════════════════════
# Leave empty if they are already on PATH.
#   winget install yt-dlp     |  choco install yt-dlp
#   winget install ffmpeg     (needed for audio extraction + format merging)
YTDLP_PATH=
FFMPEG_PATH=
YTDLP_DOWNLOAD_DIR=


# ═══ OPTIONAL: paths and timeouts ═══════════════════════════════════════════
# All default to sensible locations; set only to relocate state.
# CARTER_DB_PATH          SQLite file         default ./carter.db
# CARTER_VAULT            memory vault dir    default ./vault
# CARTER_WORKSPACE_DIR    script sandbox dir
# CARTER_UPLOAD_DIR       HUD uploads         default <tmp>/carter-uploads
# CARTER_FILES_DIR        generated PDFs      default <tmp>/carter-files
# VISION_HIL_TIMEOUT     ms to wait for a human approval, default 30000
# HUD_URL                target for scripts/hud_selfcheck.mjs, default
#                        http://127.0.0.1:3132
